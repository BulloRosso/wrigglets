{
  "name": "@cw/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent container process: API/BFF, Temporal worker and Agent Harness supervisor (one Node process).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-workflows.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@azure/identity": "4.14.0",
    "@azure/monitor-opentelemetry": "1.20.1",
    "@azure/storage-blob": "12.34.0",
    "@cw/auth-rp": "workspace:*",
    "@cw/codec": "workspace:*",
    "@cw/harness-config": "workspace:*",
    "@cw/shared": "workspace:*",
    "@cw/workflows": "workspace:*",
    "@opencode-ai/sdk": "1.19.4",
    "@opentelemetry/api": "1.9.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "lru-cache": "11.5.3",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
