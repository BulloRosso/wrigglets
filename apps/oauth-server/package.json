{
  "name": "@cw/oauth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenID Connect / OAuth 2.0 authorization server (node-oidc-provider) with a management API used by the admin plane.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/shared": "workspace:*",
    "express": "5.3.0",
    "oidc-provider": "9.13.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@types/oidc-provider": "9.12.1"
  }
}
