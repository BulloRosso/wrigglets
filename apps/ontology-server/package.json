{
  "name": "@cw/ontology-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liquid Enterprise enterprise core (ADR-0049): event log and lake, the ontology at runtime with the action pipeline (REST + MCP), embedded object policy, business worker (Temporal namespace business).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-workflows.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/business-workflows": "workspace:*",
    "@cw/lake": "workspace:*",
    "@cw/ontology-codegen": "workspace:*",
    "@cw/ontology-ir": "workspace:*",
    "@cw/ontology-sofa": "workspace:*",
    "@cw/policy-wasm": "workspace:*",
    "@cw/sofa-domain": "workspace:*",
    "@duckdb/node-api": "2.0.0-r.1",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5"
  }
}
