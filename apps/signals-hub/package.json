{
  "name": "@cw/signals-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signals hub (optional, ADR-0037): observation connectors (HTTP, IMAP, MQTT) with a durable outbox, and the MCP upstream for agents.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/secrets": "workspace:*",
    "@cw/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "imapflow": "2.9.1",
    "mailparser": "3.13.0",
    "mqtt": "5.16.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "vitest": "5.0.5"
  }
}
