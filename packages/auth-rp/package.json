{
  "name": "@cw/auth-rp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenID Connect relying party for Express (authorization code + PKCE, encrypted session cookie). Shared by agent-server and admin-server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cw/shared": "workspace:*",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.3.0"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  }
}
