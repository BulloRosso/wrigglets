{
  "name": "@cw/ontology-ir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liquid Enterprise ontology IR (ADR-0041): the contract between the LinkML compiler and every generator. Zod schema, canonical hash, loader, graph view for the editor.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
