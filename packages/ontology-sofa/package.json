{
  "name": "@cw/ontology-sofa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The sofa company's compiled ontology (ADR-0041): the IR (ir/ontology.ir.json), compiled from ontology/sofa by node scripts/liquid/ontology-build.mjs. Everything else is computed from it at runtime.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ir"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/ontology-ir": "workspace:*"
  },
  "devDependencies": {
    "@cw/ontology-codegen": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "vitest": "5.0.5"
  }
}
