{
  "name": "@cw/playbooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liquid Enterprise playbooks (ADR-0047): schema, step registry with directions, the tighten-only validator, templates, blast radius. Pure: usable in workflows and the browser.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
