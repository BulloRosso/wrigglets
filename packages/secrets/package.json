{
  "name": "@cw/secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secret store on Azure Key Vault (official SDK). Locally backed by the Lowkey Vault emulator (ADR-0024).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@azure/keyvault-secrets": "4.11.2"
  }
}
