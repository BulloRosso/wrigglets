{
  "name": "@cw/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Temporal workflow code (AgentWorkflow, TaskWorkflow, MaintenanceWorkflow). No Node APIs, no I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "default": "./dist/messages.js"
    },
    "./activity-types": {
      "types": "./dist/activity-types.d.ts",
      "default": "./dist/activity-types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/shared": "workspace:*",
    "@temporalio/common": "1.24.0",
    "@temporalio/workflow": "1.24.0"
  },
  "devDependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "vitest": "5.0.5"
  }
}
